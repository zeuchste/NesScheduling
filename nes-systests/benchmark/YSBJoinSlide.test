# name: benchmark/YSBJoinSlide.test
# description: Sliding-window workload for the incremental-index question: 10 s windows sliding by 1 s
#              (10x overlap - each tuple lives in 10 windows). The regime where an incrementally
#              maintained index amortizes across overlapping windows while trigger-time directories
#              (sort) pay per window. Same YSB data, keys and rates as the tumbling sweeps.
# groups: [benchmark, large, Join]

CREATE LOGICAL SOURCE views(user_id UINT64 NOT NULL, page_id UINT64 NOT NULL, campaign_id UINT64 NOT NULL, ad_type UINT64 NOT NULL, event_type UINT64 NOT NULL, current_ms UINT64 NOT NULL, ip UINT64 NOT NULL, d1 UINT64 NOT NULL, d2 UINT64 NOT NULL, d3 UINT32 NOT NULL, d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR views TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE LOGICAL SOURCE clicks(c_user_id UINT64 NOT NULL, c_page_id UINT64 NOT NULL, c_campaign_id UINT64 NOT NULL, c_ad_type UINT64 NOT NULL, c_event_type UINT64 NOT NULL, c_current_ms UINT64 NOT NULL, c_ip UINT64 NOT NULL, c_d1 UINT64 NOT NULL, c_d2 UINT64 NOT NULL, c_d3 UINT32 NOT NULL, c_d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR clicks TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE SINK slideChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, view_user UINT64 NOT NULL, click_user UINT64 NOT NULL, campaign_id UINT64 NOT NULL) TYPE Checksum;

# Query 1: 10 s windows sliding by 1 s (10x overlap)
SELECT start, end, user_id AS view_user, c_user_id AS click_user, campaign_id
FROM (SELECT * FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT * FROM clicks WHERE c_event_type = UINT64(1)) ON campaign_id = c_campaign_id
WINDOW SLIDING (current_ms, c_current_ms, SIZE 10 SEC, ADVANCE BY 1 SEC)
INTO slideChecksum;
----
PLACEHOLDER_SLIDE
