# name: benchmark/YSBJoinSel.test
# description: Match-rate sweep for the Bloom pre-filter and one-sided directories: the views side keeps
#              the full key domain (campaign_id % 10000); the clicks side shifts keys >= M out of the
#              domain (+20000), so only click keys < M can match. M = 10000/5000/1000/100 gives
#              ~100% / 50% / 10% / 1% match rate at unchanged build volume on both sides.
#              Memory source: no file I/O or parsing in the measured path.
# groups: [benchmark, large, Join]

CREATE LOGICAL SOURCE views(user_id UINT64 NOT NULL, page_id UINT64 NOT NULL, campaign_id UINT64 NOT NULL, ad_type UINT64 NOT NULL, event_type UINT64 NOT NULL, current_ms UINT64 NOT NULL, ip UINT64 NOT NULL, d1 UINT64 NOT NULL, d2 UINT64 NOT NULL, d3 UINT32 NOT NULL, d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR views TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE LOGICAL SOURCE clicks(c_user_id UINT64 NOT NULL, c_page_id UINT64 NOT NULL, c_campaign_id UINT64 NOT NULL, c_ad_type UINT64 NOT NULL, c_event_type UINT64 NOT NULL, c_current_ms UINT64 NOT NULL, c_ip UINT64 NOT NULL, c_d1 UINT64 NOT NULL, c_d2 UINT64 NOT NULL, c_d3 UINT32 NOT NULL, c_d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR clicks TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE SINK selChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, view_user UINT64 NOT NULL, click_user UINT64 NOT NULL, k UINT64 NOT NULL) TYPE Checksum;

# Query 1: M=10000 (~100% match rate; reference point identical in shape to the dup sweep's D=10000)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(10000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(10000) + UINT64(20000) * (c_campaign_id % UINT64(10000) / UINT64(10000)) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO selChecksum;
----
301010 560200894

# Query 2: M=5000 (~50% match rate)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(10000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(10000) + UINT64(20000) * (c_campaign_id % UINT64(10000) / UINT64(5000)) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO selChecksum;
----
151220 280245702

# Query 3: M=1000 (~10% match rate)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(10000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(10000) + UINT64(20000) * (c_campaign_id % UINT64(10000) / UINT64(1000)) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO selChecksum;
----
30160 54555653

# Query 4: M=100 (~1% match rate)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(10000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(10000) + UINT64(20000) * (c_campaign_id % UINT64(10000) / UINT64(100)) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO selChecksum;
----
3170 5568556
