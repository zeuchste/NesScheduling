# name: benchmark/YSBJoinMem.test
# description: YSB-style stream join for the edge-join design space, ingested via the Memory source:
#              the CSV is pre-parsed into engine-native buffers at source open() and the parser stage is
#              elided ("Native"), so the measured path contains no file I/O and no parsing. The expected
#              checksums are identical to the File-source variants of the same queries by construction.
# groups: [benchmark, large, Join]

CREATE LOGICAL SOURCE views(user_id UINT64 NOT NULL, page_id UINT64 NOT NULL, campaign_id UINT64 NOT NULL, ad_type UINT64 NOT NULL, event_type UINT64 NOT NULL, current_ms UINT64 NOT NULL, ip UINT64 NOT NULL, d1 UINT64 NOT NULL, d2 UINT64 NOT NULL, d3 UINT32 NOT NULL, d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR views TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE LOGICAL SOURCE clicks(c_user_id UINT64 NOT NULL, c_page_id UINT64 NOT NULL, c_campaign_id UINT64 NOT NULL, c_ad_type UINT64 NOT NULL, c_event_type UINT64 NOT NULL, c_current_ms UINT64 NOT NULL, c_ip UINT64 NOT NULL, c_d1 UINT64 NOT NULL, c_d2 UINT64 NOT NULL, c_d3 UINT32 NOT NULL, c_d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR clicks TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE SINK joinChecksum1s(start UINT64 NOT NULL, end UINT64 NOT NULL, view_user UINT64 NOT NULL, click_user UINT64 NOT NULL, campaign_id UINT64 NOT NULL) TYPE Checksum;
CREATE SINK joinChecksum10s(start UINT64 NOT NULL, end UINT64 NOT NULL, view_user UINT64 NOT NULL, click_user UINT64 NOT NULL, campaign_id UINT64 NOT NULL) TYPE Checksum;

# Query 1: views x clicks per campaign in 1s tumbling windows (storage/algorithm experiments)
SELECT start, end, user_id AS view_user, c_user_id AS click_user, campaign_id
FROM (SELECT * FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT * FROM clicks WHERE c_event_type = UINT64(1)) ON campaign_id = c_campaign_id
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO joinChecksum1s;
----
300935 560080162

# Query 2: views x clicks per campaign in 10s tumbling windows (probe-granularity experiments)
SELECT start, end, user_id AS view_user, c_user_id AS click_user, campaign_id
FROM (SELECT * FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT * FROM clicks WHERE c_event_type = UINT64(1)) ON campaign_id = c_campaign_id
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 10 SEC)
INTO joinChecksum10s;
----
2995305 5547916254
