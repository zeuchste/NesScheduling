# name: benchmark/YSBJoinDup.test
# description: Duplicates-per-key sweep for the S2/A2 crossover: the join key is campaign_id % D, so
#              shrinking D raises duplicates per key per window at fixed window size and data volume.
#              With ~950 views and ~150 clicks per 1s window, views-side duplicates/key/window are
#              approximately 0.08 (D=10000), 0.3 (3000), 0.9 (1000), 3 (300), 9 (100), 30 (30).
#              Memory source: no file I/O or parsing in the measured path.
# groups: [benchmark, large, Join]

CREATE LOGICAL SOURCE views(user_id UINT64 NOT NULL, page_id UINT64 NOT NULL, campaign_id UINT64 NOT NULL, ad_type UINT64 NOT NULL, event_type UINT64 NOT NULL, current_ms UINT64 NOT NULL, ip UINT64 NOT NULL, d1 UINT64 NOT NULL, d2 UINT64 NOT NULL, d3 UINT32 NOT NULL, d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR views TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE LOGICAL SOURCE clicks(c_user_id UINT64 NOT NULL, c_page_id UINT64 NOT NULL, c_campaign_id UINT64 NOT NULL, c_ad_type UINT64 NOT NULL, c_event_type UINT64 NOT NULL, c_current_ms UINT64 NOT NULL, c_ip UINT64 NOT NULL, c_d1 UINT64 NOT NULL, c_d2 UINT64 NOT NULL, c_d3 UINT32 NOT NULL, c_d4 UINT16 NOT NULL);
CREATE PHYSICAL SOURCE FOR clicks TYPE Memory;
ATTACH FILE huge/ysb/ysb_10k_data_25000000.csv

CREATE SINK dupChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, view_user UINT64 NOT NULL, click_user UINT64 NOT NULL, k UINT64 NOT NULL) TYPE Checksum;

# Query 1: D=10000 (~0.08 dup/key/window)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(10000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(10000) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
301010 560200894

# Query 2: D=3000 (~0.3 dup/key/window)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(3000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(3000) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
1020865 1876357895

# Query 3: D=1000 (~0.9 dup/key/window)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(1000) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(1000) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
2989150 5406623137

# Query 4: D=300 (~3 dup/key/window)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(300) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(300) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
9977490 17882652715

# Query 5: D=100 (~9 dup/key/window — the multicore study's crossover region)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(100) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(100) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
29920650 52563949579

# Query 6: D=30 (~30 dup/key/window)
SELECT start, end, view_user, click_user, k
FROM (SELECT user_id AS view_user, campaign_id % UINT64(30) AS k, current_ms FROM views WHERE event_type < UINT64(1))
INNER JOIN (SELECT c_user_id AS click_user, c_campaign_id % UINT64(30) AS c_k, c_current_ms FROM clicks WHERE c_event_type = UINT64(1)) ON k = c_k
WINDOW TUMBLING (current_ms, c_current_ms, SIZE 1 SEC)
INTO dupChecksum;
----
99779955 173815970640
