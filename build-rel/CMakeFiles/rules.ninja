  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=nes-query-engine/tests/CMakeFiles/callback-test.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
