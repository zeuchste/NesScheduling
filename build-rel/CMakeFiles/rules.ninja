  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=nes-frontend/apps/CMakeFiles/nes-repl-embedded.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
